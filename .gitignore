build/
run-*/
*.log
*.vcd
.venv/
__pycache__/

# mnist_npu: raw dataset downloads (regenerable via tools/fetch_mnist.sh)
data/

# mnist_npu verification EVIDENCE is versioned (run dirs + iterations.log);
# only compiled/generated junk is excluded. (run-*/ + *.log above would
# otherwise swallow the evidence dirs.)
!mnist_npu/verify/iterations.log
!mnist_npu/verify/run-*/
!mnist_npu/verify/run-*/**
mnist_npu/verify/run-*/**/*.vvp
mnist_npu/verify/**/sim_build/
mnist_npu/verify/**/__pycache__/

# cnn (PRJ-005 v2) verification EVIDENCE is versioned too (same policy).
!cnn/verify/iterations.log
!cnn/verify/run-*/
!cnn/verify/run-*/**
cnn/verify/run-*/**/*.vvp
cnn/verify/**/sim_build/
cnn/verify/**/__pycache__/

# cnn_soc (PRJ-005) SoC verification EVIDENCE is versioned too (same policy).
!cnn_soc/verify/iterations.log
!cnn_soc/verify/run-*/
!cnn_soc/verify/run-*/**
cnn_soc/verify/run-*/**/*.vvp
cnn_soc/verify/**/sim_build/
cnn_soc/verify/**/__pycache__/
