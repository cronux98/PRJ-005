%% fsm_diagrams.mmd — all control FSMs, one stateDiagram-v2 each.
%% Arc labels are the exact Verilog condition expressions.

%% FSM-001 : learner (binary 3-bit encoding, reset state = IDLE)
stateDiagram-v2
  [*] --> IDLE
  IDLE --> FWD_H : run_active && sample_valid
  FWD_H --> FWD_H : (h_cnt < HIDDEN-1) || !mac_div_done
  FWD_H --> FWD_O : h_cnt == HIDDEN-1 && div_done
  FWD_O --> FWD_O : (c_cnt < CLASSES-1) || !mac_div_done
  FWD_O --> DONE : c_cnt == CLASSES-1 && div_done && freeze_ff
  FWD_O --> BP_O : c_cnt == CLASSES-1 && div_done && !freeze_ff
  BP_O --> BP_O : c_cnt < CLASSES-1 || !delta_ready
  BP_O --> BP_H : c_cnt == CLASSES-1 && delta_ready
  BP_H --> BP_H : h_cnt < HIDDEN-1 || !delta_ready
  BP_H --> UPD_O : h_cnt == HIDDEN-1 && delta_ready
  UPD_O --> UPD_O : !(c_cnt == CLASSES-1 && bias_done)
  UPD_O --> UPD_H : c_cnt == CLASSES-1 && bias_done
  UPD_H --> UPD_H : !(h_cnt == HIDDEN-1 && bias_done)
  UPD_H --> DONE : h_cnt == HIDDEN-1 && bias_done
  DONE --> IDLE : 1

%% FSM-002 : sample_stream (binary, reset state = WAIT)
stateDiagram-v2
  [*] --> WAIT
  WAIT --> WAIT : beat && !s_last && px_cnt < FEATURES
  WAIT --> WAIT : beat && s_last && px_cnt == FEATURES
  WAIT --> RESYNC : beat && s_last && px_cnt < FEATURES
  WAIT --> RESYNC : beat && !s_last && px_cnt == FEATURES
  RESYNC --> RESYNC : !beat || (beat && !s_last)
  RESYNC --> WAIT : beat && s_last

%% FSM-003 : init_walk (weight_ram; binary, reset state = IDLE)
stateDiagram-v2
  [*] --> IDLE
  IDLE --> WALK : init_go
  WALK --> WALK : addr < W_TOT-1
  WALK --> IDLE : addr == W_TOT-1

%% FSM-004 : div_seq (binary, reset state = IDLE)
stateDiagram-v2
  [*] --> IDLE
  IDLE --> ITER : div_start
  ITER --> ITER : iter < 32
  ITER --> DONE : iter == 32
  DONE --> IDLE : 1
