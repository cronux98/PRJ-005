flowchart TB
  subgraph CD_CORE["CD_CORE — 25 MHz (clk_core / rst_n synchronous)"]
    B2["BLK-002<br/>apb_regs"]
    B3["BLK-003<br/>sample_stream"]
    B4["BLK-004<br/>learner"]
    B5["BLK-005<br/>weight_ram"]
    B6["BLK-006<br/>stats"]
    B7["BLK-007<br/>div_seq"]
